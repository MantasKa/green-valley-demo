<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.green_valley_stock</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='inventory_group']" position="inside">
                <field name="last_delivery_date" readonly="1"/>
                <field name="warranty_end_date" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_tree" model="ir.ui.view">
        <field name="name">stock.production.lot.list.inherit.green_valley_stock</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="warranty_end_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="search_product_lot_filter" model="ir.ui.view">
        <field name="name">stock.lot.search.inherit.green_valley_stock</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='on_hand']" position="after">
                <separator/>
                <filter string="Expiring in 30 days" name="warranty_expiring_30_days"
                        domain="[('warranty_end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('warranty_end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
